# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sewasathi?retryWrites=true&w=majority

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Admin Credentials (IMPORTANT: Change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately

# Ollama AI Configuration (Llama 3.1)
# Make sure Ollama is running: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Razorpay Payment Sandbox Configuration
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Feature Flags
ENABLE_PAYMENT_SANDBOX=true
ENABLE_MOCK_WELFARE=true
ENABLE_AI_BOOKING=true

