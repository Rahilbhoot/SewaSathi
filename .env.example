# ========================================
# SEWASATHI - Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control!

# ========================================
# Server Configuration
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# Database Configuration
# ========================================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sewasathi?retryWrites=true&w=majority

# ========================================
# JWT & Authentication
# ========================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars

# Admin Credentials (Change these immediately!)
# Use environment variables instead of hardcoding in source
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_immediately

# ========================================
# Ollama AI Configuration (Llama 3.1)
# ========================================
# Ollama Server URL - ensure Ollama is running locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ========================================
# Payment Gateway (Razorpay)
# ========================================
# Test Keys - Sandbox Mode
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret

# Webhook Secret for payment verification
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ========================================
# Email Configuration (Optional)
# ========================================
# For booking confirmations and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@sewasathi.local

# ========================================
# Frontend Configuration
# ========================================
VITE_API_URL=http://localhost:5000/api
VITE_ENV=development

# ========================================
# Logging & Monitoring
# ========================================
LOG_LEVEL=info
# LOG_FILE=/var/log/sewasathi/app.log

# ========================================
# Feature Flags
# ========================================
ENABLE_PAYMENT_SANDBOX=true
ENABLE_MOCK_WELFARE=true
ENABLE_AI_BOOKING=true
